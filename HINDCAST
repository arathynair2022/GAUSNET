# Hindcasting and Evaluating Models

def evaluate_model(model, test_loader):
    model.eval()
    all_preds = []
    all_actuals = []
    with torch.no_grad():
        for X_batch, y_batch in test_loader:
            y_pred = model(X_batch.unsqueeze(2))  # For LSTM/GRU, add an extra dimension for time steps
            all_preds.append(y_pred.squeeze().numpy())
            all_actuals.append(y_batch.numpy())

    all_preds = np.concatenate(all_preds)
    all_actuals = np.concatenate(all_actuals)

    rmse = np.sqrt(mean_squared_error(all_actuals, all_preds))
    r2 = r2_score(all_actuals, all_preds)

    print(f'RMSE: {rmse}')
    print(f'R2 Score: {r2}')

# Initialize models
lstm_model = LSTMModel(input_dim=X_train.shape[1])
gru_model = GRUModel(input_dim=X_train.shape[1])

